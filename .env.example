NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=
CRON_SECRET=
# Set to false for invite-only deployments; new sign-ups always wait for admin employee-matching approval
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=true
# Set to true to send Content-Security-Policy-Report-Only instead of enforcing while testing in production
CSP_REPORT_ONLY=false
# Set to true temporarily only when running a legacy JSON backup import via POST /api/import in production
ENABLE_LEGACY_IMPORT=false

# Routing & Map Tiles (recommended for production to avoid public demo/tile limits)
# Self-hosted OSRM instance base URL (e.g. https://osrm.internal.example.com)
OSRM_BASE_URL=
# Set to true only if production should fall back to public OSRM demo servers when OSRM_BASE_URL is unset
ALLOW_PUBLIC_OSRM_FALLBACK=false
# Set to true only if production should fall back to per-instance memory rate limiting when the shared store is unavailable
ALLOW_MEMORY_RATE_LIMIT_FALLBACK=false
# Custom street / satellite XYZ tile templates containing {z}, {x}, and {y}
NEXT_PUBLIC_MAP_STREET_TILE_URL=
NEXT_PUBLIC_MAP_STREET_ATTRIBUTION=
NEXT_PUBLIC_MAP_SATELLITE_TILE_URL=
NEXT_PUBLIC_MAP_SATELLITE_ATTRIBUTION=

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Accepts either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only (Vercel env var, never NEXT_PUBLIC_). Used by /api/import.
# Accepts either SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SECRET_KEY=sb_secret_...
